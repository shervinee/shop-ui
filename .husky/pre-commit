#!/usr/bin/env sh
# Portable Husky v10 pre-commit (find Node even in bare shells)

# 1) Try current PATH
NODE_BIN="$(command -v node 2>/dev/null || true)"

# 2) Common global installs (Apple Silicon & Intel Homebrew, Volta)
[ -z "$NODE_BIN" ] && [ -x "/opt/homebrew/bin/node" ] && NODE_BIN="/opt/homebrew/bin/node"
[ -z "$NODE_BIN" ] && [ -x "/usr/local/bin/node" ] && NODE_BIN="/usr/local/bin/node"
[ -z "$NODE_BIN" ] && [ -x "$HOME/.volta/bin/node" ] && NODE_BIN="$HOME/.volta/bin/node"

# 3) nvm (initialize and use default)
if [ -z "$NODE_BIN" ] && [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
  NODE_BIN="$(command -v node 2>/dev/null || true)"
fi

# Bail if still missing
if [ -z "$NODE_BIN" ]; then
  echo "❌ Node.js not found in Git hook environment." >&2
  echo "   Add Node to PATH or install via Homebrew/nvm/Volta." >&2
  exit 127
fi

# Ensure the directories with node and local binaries are on PATH
export PATH="$(dirname "$NODE_BIN"):./node_modules/.bin:$PATH"

# Run staged-file tasks
lint-staged
